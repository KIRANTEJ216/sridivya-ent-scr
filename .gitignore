# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# received RFQs — customer PII, never commit these
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA scratch: browser session logs and ad-hoc screenshots
.playwright-mcp/

# superseded hero footage (the homepage now uses public/line*/ frame sequences)
/public/world/*.mp4
/public/seq/
/public/seq-m/

# raw kie.ai generations: source material, regenerated on demand
/scrollcraft/builds/*/gen/*.png
/scrollcraft/builds/*/gen/*.mp4
/scrollcraft/builds/*/gen/*.jpg
/scrollcraft/builds/*/gen/*.log

# local tooling state
/.claude-flow/
/.claude/
